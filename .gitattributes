# Force all Python files to be recognized as Python
*.py linguist-language=Python
*.py linguist-detectable=true
*.py linguist-documentation=false
*.py linguist-vendored=false

# Explicitly override roff detection
* -linguist-language=roff
*.* -linguist-language=roff

# Documentation
*.md linguist-documentation
*.txt linguist-documentation
README.* linguist-documentation

# Vendored files
*.pkl linguist-vendored
models/*.pkl linguist-vendored
data/processed/*.pkl linguist-vendored
Makefile linguist-vendored
*.sh linguist-vendored
*.bat linguist-vendored
LICENSE linguist-vendored
.env linguist-vendored
*.xml linguist-vendored
data/raw/* linguist-vendored
data/external/* linguist-vendored

# Binary files
*.pdf -diff -merge -text
*.png -diff -merge -text
*.jpg -diff -merge -text
*.jpeg -diff -merge -text
*.gif -diff -merge -text
*.ico -diff -merge -text
*.zip -diff -merge -text