# Force Python detection
*.py linguist-language=Python
*.py linguist-detectable=true

# Handle extensionless files in data directories
data/raw/** linguist-vendored=true
data/raw/** linguist-generated=true
data/raw/** -linguist-language=roff
data/raw/**/* linguist-vendored=true
data/raw/**/* linguist-generated=true
data/raw/**/* -linguist-language=roff

# Documentation
*.md linguist-documentation
*.txt linguist-documentation
README.* linguist-documentation

# Notebooks
*.ipynb linguist-documentation

# Vendored files and directories
*.pkl linguist-vendored
__pycache__/** linguist-vendored
.ipynb_checkpoints/** linguist-vendored
models/** linguist-vendored
Makefile linguist-vendored
*.sh linguist-vendored
*.bat linguist-vendored
LICENSE linguist-vendored
.env linguist-vendored
*.xml linguist-vendored

# Binary files
*.pdf -diff -merge -text
*.png -diff -merge -text
*.jpg -diff -merge -text